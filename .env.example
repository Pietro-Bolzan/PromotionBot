# Copy to .env and fill in the real values. Never commit .env.

# --- application ---
APP_NAME=Amazon Bot
ENVIRONMENT=local

# --- database ---
# Local-only credentials, matching the defaults in docker-compose.yml. They stop
# being hardcoded once the compose file reads them from this same file.
DATABASE_URL=postgresql+psycopg://amazonbot:amazonbot@localhost:5432/amazonbot

# --- api auth ---
# Clients must send this value in the X-API-KEY header. ASCII only.
APP_API_KEY=change-me-local

# --- amazon ---
# Minimum discount (percent) a product must have to be collected.
AMAZON_MIN_DISCOUNT_PERCENT=20

# --- openai ---
# Optional in development: an empty key makes the service fall back to a
# fixed template instead of calling (and paying for) the API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=300

# --- telegram ---
# Optional in development: without both values no message is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- scheduler ---
# Keep this false until deduplication is fixed: an ASIN that fails delivery is
# re-collected every cycle and triggers a new paid OpenAI call each time.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=600
SCHEDULER_DELIVERY_LIMIT=5
