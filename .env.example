# Copy to .env and fill in the real values. Never commit .env.

# --- application ---
APP_NAME=Amazon Bot
ENVIRONMENT=local

# --- database ---
# Must match the POSTGRES_* values below (user, password, database).
DATABASE_URL=postgresql+psycopg://amazonbot:amazonbot@localhost:5432/amazonbot

# --- postgres container (read by docker-compose.yml, not by the app) ---
# The password only takes effect when the data volume is first created.
POSTGRES_USER=amazonbot
POSTGRES_PASSWORD=amazonbot
POSTGRES_DB=amazonbot

# --- api auth ---
# Clients must send this value in the X-API-KEY header. ASCII only.
APP_API_KEY=change-me-local

# --- amazon ---
# Minimum discount (percent) a product must have to be collected.
AMAZON_MIN_DISCOUNT_PERCENT=20
# Amazon Associates tracking ID (e.g. yourname-20). Required to send
# promotions: delivery is refused without it, because untagged links earn
# no commission.
AMAZON_PARTNER_TAG=

# --- openai ---
# Optional in development: an empty key makes the service fall back to a
# fixed template instead of calling (and paying for) the API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=300
# Per attempt. The SDK retries twice on its own, so a dead API costs about
# three times this (plus backoff) before the template is used instead.
OPENAI_TIMEOUT_SECONDS=20

# --- telegram ---
# Optional in development: without both values no message is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- scheduler ---
# Collects and delivers every SCHEDULER_INTERVAL_SECONDS. Safe with several app
# processes: deliveries take a database lock, so only one sends at a time.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=600
SCHEDULER_DELIVERY_LIMIT=5
# Time zone for scheduled times, independent of the host clock.
SCHEDULER_TIMEZONE=America/Sao_Paulo

# --- delivery ---
# A failed delivery goes back to the queue until it has been tried this many
# times; then it is marked FAILED for good.
DELIVERY_MAX_ATTEMPTS=3
